{
  "schema_version": 2,
  "name": "填写网页表单",
  "when_to_use": "用户要在某个网页上填写/提交表单（注册、报名、申请、报销、登记等），可以给出网址和要填的信息。不适用于需要上传文件、验证码、或多页向导式流程中的跳转。",
  "keywords": [
    "表单",
    "填写",
    "填表",
    "提交",
    "网页",
    "报名",
    "申请",
    "登记",
    "form",
    "fill"
  ],
  "params_schema": {
    "type": "object",
    "properties": {
      "url": {
        "type": "string",
        "description": "表单页面网址；不填则使用浏览器当前页面"
      },
      "data": {
        "description": "用户已提供的要填写的信息（对象或自然语言文本）"
      },
      "submit": {
        "type": "boolean",
        "description": "填完后是否提交（提交前会请求确认）",
        "default": true
      },
      "scope": {
        "type": "string",
        "description": "可选，限定表单所在区域的 CSS 选择器"
      }
    },
    "required": []
  },
  "permissions": {
    "tools": [
      "browser_open",
      "browser_snapshot",
      "browser_fill",
      "browser_read",
      "browser_submit",
      "ask_user"
    ],
    "domains": []
  },
