# No-Agent 配置（环境变量前缀 NO_AGENT_，嵌套字段用双下划线）
# 作为库使用时也可以不用环境变量，直接构造 AgentConfig(...)

# ── LLM（OpenAI 兼容协议）──
# fast：技能匹配 / 参数抽取 / 脚本内 ctx.llm（高频，选便宜快的）
# strong：自由执行 / 接管 / 提炼 / 修补（低频，选能力强的）
NO_AGENT_LLM__BASE_URL=https://api.openai.com/v1
NO_AGENT_LLM__API_KEY=
NO_AGENT_LLM__FAST_MODEL=gpt-4o-mini
NO_AGENT_LLM__STRONG_MODEL=gpt-4o
# 强模型走不同的服务商时填写（例如 Claude 的 OpenAI 兼容接口）
NO_AGENT_LLM__STRONG_BASE_URL=
NO_AGENT_LLM__STRONG_API_KEY=
# 可选：配置后用向量召回技能，否则用词法匹配
NO_AGENT_LLM__EMBED_MODEL=

# ── 存储 ──
# 数据根目录；不填时向上查找 .no-agent/，找不到则在当前目录创建
NO_AGENT_HOME=
# 以下可单独覆盖（默认都在 HOME 下）
# NO_AGENT_SKILLS_DIR=
# NO_AGENT_EXTRA_SKILL_DIRS=["/shared/team-skills"]
# NO_AGENT_DATABASE_URL=postgresql+psycopg://user:pass@host/db
# NO_AGENT_WORKSPACE_DIR=

# ── 进化策略 ──
NO_AGENT_MATCH_MIN_CONFIDENCE=0.7
NO_AGENT_DISTILL_MIN_TRACES=2
NO_AGENT_PROMOTE_MIN_PASS_RATE=0.8
# 影子运行：新版本先在后台与真实结果比对，一致 N 次后自动转正（0 = 测试通过即上线）
NO_AGENT_SHADOW_MIN_RUNS=3
# 影子运行失败 / 不一致超过此次数，淘汰候选版本
NO_AGENT_SHADOW_MAX_FAILURES=1
NO_AGENT_RETIRE_WINDOW=10
NO_AGENT_RETIRE_MIN_SUCCESS_RATE=0.3

# ── 浏览器（需要 pip install "No-Agent[browser]"）──
# 开启后提供 browser_* 工具和内置的 fill_form（填写网页表单）技能
NO_AGENT_BROWSER__ENABLED=false
# 使用本机已安装的浏览器：chrome / msedge；留空则用 Playwright 自带的 Chromium
NO_AGENT_BROWSER__CHANNEL=chrome
# 是否隐藏浏览器窗口（默认显示，方便看到 AI 在做什么）
NO_AGENT_BROWSER__HEADLESS=false

# 浏览器资料目录（保存登录状态）；留空则每次使用干净的临时目录
# NO_AGENT_BROWSER__PROFILE_DIR=
# browser-use（需要 pip install "No-Agent[browser-use]"）：提供 browser_agent 工具，做开放式网页探索
NO_AGENT_BROWSER__BROWSER_USE=false
# NO_AGENT_BROWSER__BROWSER_USE_MODEL=            # 默认使用 STRONG 模型
# NO_AGENT_BROWSER__BROWSER_USE_CONFIRM=true      # 交给 browser-use 前请求确认

# ── 接入外部 MCP 服务（需要 pip install "No-Agent[mcp]"），JSON 数组 ──
# NO_AGENT_MCP_SERVERS=[{"name": "github", "command": "npx", "args": ["-y", "@modelcontextprotocol/server-github"]}]

# ── 确认 ──
# 提交表单等需确认的操作，默认每次在终端里询问；设为 true 则直接执行（无人值守时使用，谨慎）
NO_AGENT_AUTO_CONFIRM=false
